# Generate two DIFFERENT secrets using: openssl rand -hex 32
MCP_BEARER_TOKEN=
MCP_TUNNEL_TOKEN=
# Include the exact HTTPS domain Host here if exposing direct HTTP via Dokploy.
MCP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,boosty-mcp:8080,boosty-mcp:8081
BOOSTY_READ_ONLY=false
# Used only by docker-compose.tunnel.yml. Obtain from your OpenAI tunnel setup.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
IMAGE_TAG=local
